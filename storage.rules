rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /circulars/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    // Team chat files: signed-in staff only, up to 10 MB each. Files are removed automatically
    // with their message 100 days after it was sent (by the scheduled server job).
    match /chat/{roomId}/{messageId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.size <= 10 * 1024 * 1024;
      allow update, delete: if false;
    }
  }
}
