rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chat-only staff (people who use Vertex Chat but not the Pricing app) carry the custom claim chatOnly. They are signed
    // in (isChatUser) but NOT "signed in" for everything else: every rule below that says isSignedIn() refuses them,
    // so they can reach chat (which uses isChatUser) and nothing else.
    function isChatUser() {
      return request.auth != null && request.auth.uid != null;
    }
    function isSignedIn() {
      return isChatUser() && request.auth.token.get('chatOnly', false) != true;
    }

    // The users collection carries each account's password (mirrored here
    // as a fallback alongside Firebase Auth) — under the old blanket
    // isSignedIn() write rule, any logged-in team member could overwrite
    // (or read, in plain text) any other user's credentials. Writes are now
    // restricted to the admin account or a user's own document (self-service
    // password change writes only to users/{yourself}); every other
    // collection is unchanged.
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'ganny@atlaspricing.com';
    }
    function isOwnUserDoc(userId) {
      return isSignedIn() && request.auth.token.email.split('@')[0] == userId;
    }
    // Sales Module (test app) — accounts/salesContacts/salesTargets/
    // salesTerritories only. Deliberately NOT applied to leads/activities:
    // the legacy app also reads/writes those two collections directly, and
    // tightening them risks breaking its live usage in ways that can't be
    // verified without touching legacy code.
    function ownerUsername() {
      return isSignedIn() ? request.auth.token.email.split('@')[0] : null;
    }
    function isSalesAdmin() {
      return isSignedIn() && request.auth.token.email in
        ['ganny@atlaspricing.com', 'manager@atlaspricing.com', 'admin@atlaspricing.com'];
    }

    match /quotes/{quoteId} { allow read, write: if isSignedIn(); }
    match /amendment_requests/{requestId} { allow read, write: if isSignedIn(); }
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwnUserDoc(userId);
    }
    match /custom_autocomplete_entries/{entryId} { allow read, write: if isSignedIn(); }
    match /customer_control/{customerId} { allow read, write: if isSignedIn(); }
    match /nrs_registry/{entryId} { allow read, write: if isSignedIn(); }
    // --- test-app only (desk-owned NRS queue) --------------------------------
    // The NRS desk's follow-ups and confirmation alerts, shared by desk instead of
    // sitting in one browser. Any desk can create one when a quote is won; the NRS
    // seat works them. Stored by desk, never by person, so it survives a seat
    // change. The legacy app does not read or write these.
    match /nrs_followups/{followUpId} { allow read, write: if isSignedIn(); }
    match /nrs_alerts/{alertId} { allow read, write: if isSignedIn(); }
    // --- test-app only (Quote Hub) --------------------------------------------
    // Enquiries read from dropped emails/documents, waiting to be opened in a desk.
    // Shared by desk; the app filters who sees which. The legacy app never touches them.
    match /quoteHubJobs/{jobId} { allow read, write: if isSignedIn(); }
    // --- test-app only (Ask Vertex chat) --------------------------------------
    // Each person's chat history is private to them. Usage counters are written by the
    // server only; a person can read their own, and an admin can read everyone's.
    match /chatThreads/{threadId} {
      allow read, update, delete: if isSignedIn() && resource.data.owner == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.owner == request.auth.uid;
    }
    match /chatUsage/{usageId} {
      allow read: if isSignedIn() && (usageId.matches(request.auth.uid + '_.*') || isAdmin());
      allow write: if false;
    }
    // --- test-app only (Team chat) --------------------------------------------
    // Desk chats, groups and direct messages between colleagues. A room lists the logins that
    // may see it (desk chats follow whoever sits in the desk; "Everyone" is open to all signed-in
    // staff). Messages are readable by room members and by the administrator, who reviews chats
    // under company policy (each review is recorded in chatAudit). People can write only as
    // themselves, edit only their own words, and nobody can hard-delete from the app: messages
    // are removed automatically 100 days after they were sent by a scheduled server job.
    // The legacy app never touches these collections.
    function chatLogin() { return request.auth.token.email.split('@')[0]; }
    function chatCanSee(room) {
      return room.get('audience', 'list') == 'all' || chatLogin() in room.get('memberLogins', []);
    }
    match /chatRooms/{roomId} {
      function roomData() { return get(/databases/$(database)/documents/chatRooms/$(roomId)).data; }
      allow read: if isChatUser() && (chatCanSee(resource.data) || isAdmin());
      allow create: if isChatUser() && (
        isAdmin()
        || (request.resource.data.kind in ['group', 'dm']
            && request.resource.data.audience == 'list'
            && request.resource.data.createdBy == chatLogin()
            && chatLogin() in request.resource.data.memberLogins
            && (request.resource.data.kind != 'dm' || request.resource.data.memberLogins.size() in [1, 2]))
        || (roomId == 'everyone' && request.resource.data.kind == 'channel' && request.resource.data.audience == 'all')
      );
      allow update: if isChatUser() && (
        isAdmin()
        || (chatCanSee(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessageAt', 'lastMessageText', 'lastMessageBy', 'pinned', 'mentioned']))
        || (resource.data.kind == 'group' && resource.data.createdBy == chatLogin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberLogins']))
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatUser() && (chatCanSee(roomData()) || isAdmin());
        allow create: if isChatUser() && chatCanSee(roomData())
          && request.resource.data.senderLogin == chatLogin()
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow update: if isChatUser() && chatCanSee(roomData()) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          || (resource.data.senderLogin == chatLogin()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['text', 'editedAtMs', 'deleted', 'attachments', 'mentions', 'quote']))
        );
        allow delete: if false;
      }
      match /typing/{login} {
        allow read: if isChatUser() && (chatCanSee(roomData()) || isAdmin());
        allow write: if isChatUser() && login == chatLogin() && chatCanSee(roomData());
      }
      match /receipts/{login} {
        allow read: if isChatUser() && (chatCanSee(roomData()) || isAdmin());
        allow write: if isChatUser() && login == chatLogin() && chatCanSee(roomData());
      }
    }
    // Who is online, each person's own read marks / muted chats / notification devices, and the
    // administrator's review log (admin can add entries and read them; nobody can change or remove one).
    // --- test-app only (Rate requests) ----------------------------------------
    // Log of the rate-request emails desks send to agents and vendors. Written only by the
    // server function that sends them; any signed-in user can read it. Per-person daily send
    // counters are server-only. The legacy app never touches these.
    match /rateRequests/{refId} { allow read: if isSignedIn(); allow write: if false; }
    match /rateRequestCaps/{capId} { allow read, write: if false; }
    // --- test-app only (Sign-in and activity log) -----------------------------
    // One record per working session: when someone signed in, when the app last saw them, how long they
    // were really using it, and any long idle stretches. People write only their own record, can only
    // add to the running totals (never lower them or change the start time), and cannot delete it.
    // The administrator reads them all. The legacy app never touches this collection.
    match /sessionLog/{sessionId} {
      allow read: if isChatUser() && (isAdmin() || resource.data.login == chatLogin());
      allow create: if isChatUser()
        && request.resource.data.login == chatLogin()
        && request.resource.data.startAt == request.time
        && request.resource.data.keys().hasOnly(['login', 'name', 'startAt', 'startMs', 'lastSeenAt', 'lastSeenMs', 'activeSec', 'idleMin', 'longestIdleMin', 'ua', 'version']);
      allow update: if isChatUser()
        && resource.data.login == chatLogin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastSeenAt', 'lastSeenMs', 'activeSec', 'idleMin', 'longestIdleMin', 'endMs', 'endReason'])
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.activeSec >= resource.data.activeSec;
      allow delete: if false;
    }
    match /chatPresence/{login} {
      allow read: if isChatUser();
      allow write: if isChatUser() && login == chatLogin();
    }
    // Each person's own chat photo (a small JPEG kept as text) and one-line work status. Everyone signed in can see them;
    // people can write only their own, only these fields, and only within the size limits the app also enforces
    // (lib/chat/profile.ts: photo 24,000 characters, status 60).
    // Carrier Board: airline rates read automatically from circulars. Everyone on the Pricing app can read them; only the
    // server (which checks each circular twice) writes them.
    match /carrierTariffs/{id} {
      allow read: if isSignedIn();
      allow write: if false;
      match /history/{entry} { allow read: if isSignedIn(); allow write: if false; }
    }
    match /carrierReads/{id} { allow read: if isSignedIn(); allow write: if false; }
    match /carrierTariffHolds/{id} { allow read: if isSignedIn(); allow write: if false; }
    match /carrierReadUsage/{id} { allow read: if isSignedIn(); allow write: if false; }
    // Auto-read on/off and its monthly limit. Anyone signed in can see it; only the server (admin callable) writes it.
    // Plain-words summaries of non-airline circulars (shipping lines, coloaders, transporters, warehouses...). Server writes only.
    match /circularDigests/{id} { allow read: if isSignedIn(); allow write: if false; }
    match /carrierReadSettings/{id} { allow read: if isSignedIn(); allow write: if false; }
    match /chatProfiles/{login} {
      allow read: if isChatUser();
      // A person can create their own record and change only their photo and status. The name and the chat-only flag are
      // set by the server when the admin adds a chat-only login, so they cannot be edited here.
      allow create: if isChatUser() && login == chatLogin()
        && request.resource.data.keys().hasOnly(['login', 'photo', 'status', 'statusAt', 'updatedAt'])
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 24000
        && request.resource.data.get('status', '') is string
        && request.resource.data.get('status', '').size() <= 60;
      allow update: if isChatUser() && login == chatLogin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['login', 'photo', 'status', 'statusAt', 'updatedAt'])
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 24000
        && request.resource.data.get('status', '') is string
        && request.resource.data.get('status', '').size() <= 60;
      allow delete: if false;
    }
    match /chatState/{login} {
      allow read, write: if isChatUser() && login == chatLogin();
    }
    match /chatAudit/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.by == chatLogin();
      allow update, delete: if false;
    }
    // --------------------------------------------------------------------------
    // --------------------------------------------------------------------------
    // --------------------------------------------------------------------------
    match /archive_quotes/{quoteId} { allow read, write: if isSignedIn(); }
    match /inbox_enquiries/{itemId} { allow read, write: if isSignedIn(); }
    match /contactsDirectory/{contactId} { allow read, write: if isSignedIn(); }
    match /password_resets/{requestId} { allow read, write: if isSignedIn(); }
    match /resetRequests/{userId} { allow read, write: if isSignedIn(); }
    match /leads/{leadId} { allow read, write: if isSignedIn(); }
    match /activities/{activityId} { allow read, write: if isSignedIn(); }
    // Visit report: the option lists the admin edits, and what people typed under "something else" (counted, offered back to the admin).
    match /salesVisitConfig/{docId} { allow read: if isSignedIn(); allow write: if isAdmin() || isSalesAdmin(); }
    match /salesVisitSuggestions/{id} {
      allow create, update: if isSignedIn() && request.resource.data.keys().hasOnly(['question', 'text', 'count', 'lastBy', 'at']);
      allow read, delete: if isAdmin() || isSalesAdmin();
    }
    match /wonFollowUps/{quoteId} { allow read, write: if isSignedIn(); }
    // Saved drafts of a desk's quote in progress. Not quotes: never listed in Enquiry DB. Visibility by desk is applied in the app, like wonFollowUps.
    match /quoteDrafts/{draftId} { allow read, write: if isSignedIn(); }
    match /customsHolidays/{holidayId} { allow read, write: if isSignedIn(); }
    match /accounts/{accountId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.owner == ownerUsername();
      allow update, delete: if isSignedIn() && (isSalesAdmin() || resource.data.owner == ownerUsername());
    }
    match /salesContacts/{contactId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.owner == ownerUsername();
      allow update, delete: if isSignedIn() && (isSalesAdmin() || resource.data.owner == ownerUsername());
    }
    match /salesTargets/{targetId} {
      allow read: if isSignedIn();
      allow write: if isSalesAdmin();
    }
    match /salesTerritories/{territoryId} {
      allow read: if isSignedIn();
      allow write: if isSalesAdmin();
    }
    // Audit trail (test app). Append-only: entries can be created by any signed-in
    // user but only as themselves (actor must equal the caller's username) and
    // stamped with server time (no back-dating); nobody can edit or delete them;
    // only admins can read them. The legacy app never touches this collection.
    match /auditLog/{entryId} {
      allow read: if isSalesAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actor == ownerUsername()
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['at', 'atIso', 'actor', 'actorRole', 'action',
             'entityType', 'entityId', 'entityLabel', 'summary', 'changes', 'app', 'version']);
      allow update, delete: if false;
    }
    // Error monitor (test app). Signed-in users can report an error only as
    // themselves, stamped with server time, with a fixed set of size-limited
    // text fields (so it can't be used to store arbitrary data or spoof another
    // user). Only admins can read, and only admins can delete (mark resolved).
    // Nobody can edit an entry. The legacy app never touches this collection.
    match /clientErrors/{errorId} {
      allow read, delete: if isSalesAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actor == ownerUsername()
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['at', 'atIso', 'actor', 'fingerprint', 'message', 'stack',
             'componentStack', 'source', 'path', 'version', 'userAgent'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 600
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.componentStack is string && request.resource.data.componentStack.size() <= 1600;
      allow update: if false;
    }
    // Who currently sits in each desk seat (Free Hand, Air Nom, ...) — shared for
    // everyone instead of living in one browser. Admin-managed; legacy app ignores it.
    match /deskSeats/{seatId} {
      allow read: if isSignedIn();
      allow write: if isSalesAdmin();
    }
    // Desk sign-in IDs (legacy + test app). Maps the ID people TYPE at sign-in to
    // the desk seat's permanent internal login, so the admin can hand a desk to a
    // new person without touching any quote or module data. A single record can be
    // fetched before sign-in (login has to resolve the ID first) but the collection
    // cannot be listed except by signed-in users; only the admin can write, and only
    // the fixed fields below. Contains no credentials — just id -> id.
    match /loginAliases/{aliasId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['target', 'retired', 'updatedAt', 'updatedBy'])
        && (request.resource.data.target == null || request.resource.data.target is string);
      allow delete: if isAdmin();
    }
    match /circularsLibrary/{circularId} { allow read, write: if isSignedIn(); }
    match /air_tariffs/{tariffId} { allow read, write: if isSignedIn(); }
    match /sea_tariffs/{tariffId} { allow read, write: if isSignedIn(); }
    match /courier_tariff_books/{bookId} { allow read, write: if isSignedIn(); }

    // Weekly Agency List — recipient list stays client-writable like every
    // other settings-style collection above (the real AIR-NOM/SEA-NOM/admin
    // edit gate is enforced client-side, matching how circularsLibrary works
    // today). "mail" is written only by the Trigger Email extension's own
    // Admin-SDK function, which bypasses rules entirely — this blocks any
    // client SDK access to it.
    match /app_settings/{settingId} { allow read, write: if isSignedIn(); }
    match /mail/{mailId} { allow read, write: if false; }
  }
}
