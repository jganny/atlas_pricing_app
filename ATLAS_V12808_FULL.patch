+  line-height: 1.45;
+}
+.enquiry-row-inspector-card.eri-has-selection {
+  box-shadow: 0 8px 24px rgba(38, 58, 154, 0.1);
+}
+
+@media (max-width: 640px) {
+  .eri-grid {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* ══════════════════════════════════════════════════
+   ATLAS COMMAND PALETTE + COPILOT (Premium + AI shell)
+══════════════════════════════════════════════════ */
+.atlas-command-palette {
+  position: fixed;
+  inset: 0;
+  z-index: 10080;
+  background: rgba(15, 23, 42, 0.45);
+  backdrop-filter: blur(4px);
+  display: none;
+  align-items: flex-start;
+  justify-content: center;
+  padding: 12vh 1rem 1rem;
+}
+.atlas-command-palette.open {
+  display: flex;
+}
+.atlas-cp-dialog {
+  width: min(520px, 100%);
+  background: #fff;
+  border-radius: 14px;
+  box-shadow: 0 24px 64px rgba(15, 23, 42, 0.22);
+  border: 1px solid #e2e8f0;
+  overflow: hidden;
+}
+.atlas-cp-input {
+  width: 100%;
+  border: none;
+  border-bottom: 1px solid #e2e8f0;
+  padding: 1rem 1.1rem;
+  font-size: 0.95rem;
+  font-weight: 600;
+  outline: none;
+  font-family: inherit;
+}
+.atlas-cp-list {
+  max-height: 320px;
+  overflow-y: auto;
+  padding: 0.35rem;
+}
+.atlas-cp-item {
+  display: block;
+  width: 100%;
+  text-align: left;
+  border: none;
+  background: transparent;
+  padding: 0.65rem 0.85rem;
+  border-radius: 8px;
+  font-size: 0.88rem;
+  font-weight: 600;
+  color: #1e293b;
+  cursor: pointer;
+  font-family: inherit;
+}
+.atlas-cp-item:hover,
+.atlas-cp-item.active {
+  background: rgba(38, 58, 154, 0.08);
+  color: #263a9a;
+}
+.atlas-cp-empty {
+  padding: 1rem;
+  color: #64748b;
+  font-size: 0.82rem;
+  text-align: center;
+}
+.atlas-cp-hint {
+  padding: 0.55rem 1rem;
+  font-size: 0.68rem;
+  color: #94a3b8;
+  border-top: 1px solid #f1f5f9;
+}
+.atlas-cp-hint kbd {
+  background: #f1f5f9;
+  border: 1px solid #e2e8f0;
+  border-radius: 4px;
+  padding: 0 0.3rem;
+  font-size: 0.65rem;
+}
+
+/* Copilot FAB + slide-over panel */
+.atlas-copilot-fab {
+  position: fixed;
+  bottom: 1.25rem;
+  left: 1.25rem;
+  z-index: 10070;
+  width: 52px;
+  height: 52px;
+  border-radius: 50%;
+  border: none;
+  background: linear-gradient(135deg, #263a9a, #1b1c5c);
+  color: #fff;
+  box-shadow: 0 8px 24px rgba(38, 58, 154, 0.35);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: transform 0.15s ease, box-shadow 0.15s ease;
+}
+.atlas-copilot-fab:hover {
+  transform: scale(1.05);
+  box-shadow: 0 12px 32px rgba(38, 58, 154, 0.4);
+}
+body.logged-out-blur .atlas-copilot-fab,
+body.logged-out-blur .atlas-copilot-panel {
+  display: none !important;
+}
+
+.atlas-copilot-panel {
+  position: fixed;
+  top: 0;
+  right: 0;
+  width: min(400px, 100vw);
+  height: 100dvh;
+  z-index: 10075;
+  background: #fff;
+  border-left: 1px solid #e2e8f0;
+  box-shadow: -12px 0 40px rgba(15, 23, 42, 0.12);
+  display: flex;
+  flex-direction: column;
+  transform: translateX(100%);
+  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
+}
+.atlas-copilot-panel.open {
+  transform: translateX(0);
+}
+.atlas-copilot-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  padding: 1rem 1.1rem;
+  border-bottom: 1px solid #e2e8f0;
+  background: linear-gradient(180deg, #f8fafc, #fff);
+}
+.atlas-copilot-eyebrow {
+  font-size: 0.62rem;
+  font-weight: 800;
+  text-transform: uppercase;
+  letter-spacing: 0.1em;
+  color: #64748b;
+}
+.atlas-copilot-title {
+  margin: 0.15rem 0 0;
+  font-size: 1.05rem;
+  font-weight: 800;
+  color: #1b1c5c;
+}
+.atlas-copilot-close {
+  background: #f1f5f9;
+  border: none;
+  width: 32px;
+  height: 32px;
+  border-radius: 8px;
+  font-size: 1.2rem;
+  cursor: pointer;
+  color: #64748b;
+}
+.atlas-copilot-quick {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+  padding: 0.65rem 1rem;
+  border-bottom: 1px solid #f1f5f9;
+}
+.atlas-copilot-quick button {
+  font-size: 0.68rem;
+  font-weight: 700;
+  padding: 0.35rem 0.55rem;
+  border-radius: 999px;
+  border: 1px solid #e2e8f0;
+  background: #f8fafc;
+  color: #334155;
+  cursor: pointer;
+  font-family: inherit;
+}
+.atlas-copilot-quick button:hover {
+  border-color: #263a9a;
+  color: #263a9a;
+}
+.atlas-copilot-log {
+  flex: 1;
+  overflow-y: auto;
+  padding: 1rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.65rem;
+  background: #fafbfc;
+}
+.atlas-copilot-msg {
+  max-width: 92%;
+  padding: 0.65rem 0.85rem;
+  border-radius: 12px;
+  font-size: 0.82rem;
+  line-height: 1.5;
+  white-space: pre-wrap;
+}
+.atlas-copilot-msg-user {
+  align-self: flex-end;
+  background: #263a9a;
+  color: #fff;
+  border-bottom-right-radius: 4px;
+}
+.atlas-copilot-msg-assistant {
+  align-self: flex-start;
+  background: #fff;
+  color: #1e293b;
+  border: 1px solid #e2e8f0;
+  border-bottom-left-radius: 4px;
+}
+.atlas-copilot-include {
+  display: flex;
+  align-items: center;
+  gap: 0.45rem;
+  padding: 0.5rem 1rem;
+  font-size: 0.72rem;
+  color: #64748b;
+  border-top: 1px solid #f1f5f9;
+}
+.atlas-copilot-compose {
+  display: flex;
+  gap: 0.5rem;
+  padding: 0.75rem 1rem 1rem;
+  border-top: 1px solid #e2e8f0;
+  background: #fff;
+}
+.atlas-copilot-compose textarea {
+  flex: 1;
+  resize: none;
+  border: 1px solid #e2e8f0;
+  border-radius: 10px;
+  padding: 0.55rem 0.75rem;
+  font-size: 0.82rem;
+  font-family: inherit;
+  outline: none;
+}
+.atlas-copilot-compose textarea:focus {
+  border-color: #263a9a;
+  box-shadow: 0 0 0 3px rgba(38, 58, 154, 0.12);
+}
+.atlas-copilot-compose .btn-primary {
+  align-self: flex-end;
+  padding: 0.55rem 1rem !important;
+  font-size: 0.78rem !important;
+}
+
+@media (max-width: 640px) {
+  .atlas-copilot-fab {
+    bottom: 5rem;
+    left: 1rem;
+  }
+}
